---
pagination:
  data: profilo
  size: 1
  alias: lingua
permalink: "/profilo-pdf/{{ lingua }}/"
eleventyExcludeFromCollections: true
---
{#- Profilo in PDF come estratto del sito (deciso il 20/11/2026): stessi componenti e stesso CSS di sounddesignrv.com,
    una pagina 16:9 (1920x1080 px = 1440x810 pt, come i vecchi PDF Canva) per ogni "schermata".
    Scuro di base (scelto da Riccardo il 20/11), chiaro con ?tema=chiaro (stesse regole html.scuro del sito).
    Si costruisce solo con PROFILO=1 (vedi .eleventy.js) e si esporta con scripts/profilo-pdf.js.
    Testi in _data/profilo.js (italiano approvato il 15/10/2026).
    Niente box-shadow: Anteprima del Mac le disegna come riquadri grigi. -#}
{%- set p = profilo[lingua] %}{%- set t = testi[lingua] %}
{%- set link = sito.url %}{%- set q = "?" + p.utm %}
{%- set totale = "08" %}
<!doctype html>
<html lang="{{ p.lang }}">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex">
<title>{{ p.titoloPagina }}</title>
<script>(function(){var q=new URLSearchParams(location.search),h=document.documentElement;if(q.get("tema")!=="chiaro")h.classList.add("scuro");if(q.get("solo")==="copertina")h.classList.add("solo-copertina")})();</script>
<style>{% include "css/sito.css" %}</style>
<style>
/* Il sito a 125%: 1rem = 20px su una pagina larga 1920 */
@page{size:1920px 1080px;margin:0}
html{font-size:20px;scroll-behavior:auto;-webkit-print-color-adjust:exact;print-color-adjust:exact}
body{background:#8a8a85;overflow:visible}
body::before{display:none}
*,*::before,*::after{box-shadow:none!important;transition:none!important;animation:none!important}
.foglio{position:relative;width:1920px;height:1080px;overflow:hidden;break-after:page;margin:0 auto 40px;
  background:linear-gradient(180deg,#FFFFFF 0%,var(--snow) 30%,#E9E2D7 100%)}
.scuro .foglio{background:linear-gradient(180deg,#43443F 0%,#2F302C 35%,#20211E 100%)}
@media print{body{background:none}.foglio{margin:0}}
/* Intestazione: solo il marchio del sito, appoggiato sulla pagina (il menu da sito non convinceva, 20/11) */
.foglio-testa{position:absolute;z-index:2;left:var(--gutter);top:1.5rem}
.foglio-testa .marchio-logo{width:2.8rem;height:2.8rem}
.foglio-piede{position:absolute;left:var(--gutter);right:var(--gutter);bottom:1.4rem;display:flex;justify-content:space-between;font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;opacity:.55}
.foglio-piede a{text-decoration:none}

/* 1. Copertina: logo, nome e ruolo. Versione B1 scelta da Riccardo il 20/11 tra A, B, C, D e gli sviluppi B1-B3:
   banda sabbia nei due terzi alti col nome in flax, logo grande a destra, riga dei quattro colori sotto la banda, ruolo in due colori */
.solo-copertina .foglio:not(.cover){display:none}
.cover{color:var(--testo)}
.cover::before{content:"";position:absolute;left:0;right:0;top:0;height:64%;background:linear-gradient(180deg,#443629 0%,color-mix(in srgb,#443629 74%,#2F302C) 100%)}
html:not(.scuro) .cover::before{background:linear-gradient(180deg,var(--flax) 0%,color-mix(in srgb,var(--flax) 74%,var(--snow)) 100%)}
.cover-testo{position:absolute;left:8rem;right:8rem;top:0;height:100%}
.cover-nome{position:absolute;left:0;bottom:calc(36% + 2.75rem);margin:0;font-size:7.5rem;font-weight:700;letter-spacing:.03em;line-height:.95;color:var(--flax)}
html:not(.scuro) .cover-nome{color:var(--jet)}
.cover-ruolo{position:absolute;left:0;top:calc(64% + 3.25rem);margin:0;font-size:2.1rem;font-weight:500;color:var(--verdigris)}
.cover-ruolo .r2{color:var(--apricot)}
.cover-logo{position:absolute;right:8rem;top:calc(32% - 9.5rem);width:19rem;height:auto}
.cover-strisce{position:absolute;left:0;right:0;top:64%;height:1rem;display:flex}
.cover-strisce i{flex:1}
.cover-strisce i:nth-child(1){background:var(--verdigris)}.cover-strisce i:nth-child(2){background:var(--apricot)}
.cover-strisce i:nth-child(3){background:var(--flax)}.cover-strisce i:nth-child(4){background:var(--testo)}

/* 2. La home: eroe con lo showreel e la fascia dei loghi */
.copertina .eroe{padding-block:7rem 2.5rem}
.copertina .eroe h1{font-size:5rem}
.copertina .eroe-intro{font-size:1.2rem;max-width:30rem}
.copertina .video{display:block}
.copertina .clienti{padding-block:2rem 0}
.copertina .loghi img{height:3.4rem}

/* 2. Chi sono: banda flax con la foto che scende sul corpo, come la pagina del sito */
.chi .pagina-testa{padding-block:7rem 2.75rem;margin-bottom:2.5rem}
.chi .pagina-testa-ritratto{grid-template-columns:1fr 24rem;gap:0 4rem}
.chi .ritratto-box{height:0}
.chi .ritratto{width:24rem;height:19rem;object-fit:cover;object-position:50% 22%;margin:0;outline:none;box-shadow:none}
.chi .ritratto-ombra{position:relative}
.chi .ritratto-ombra::before{content:"";position:absolute;inset:.75rem -.75rem -.75rem .75rem;border-radius:var(--raggio);background:var(--verdigris)}
.chi .ritratto-ombra img{position:relative}
.chi .corpo{display:grid;grid-template-columns:1fr 24rem;gap:0 4rem}
.chi .corpo p{font-size:.98rem;margin-bottom:.85em}
.chi .in-breve{margin-top:5.5rem}
.chi .in-breve h2{font-size:1.4rem;margin:0 0 .9rem;display:flex;align-items:center;gap:.5em}
.chi .in-breve h2::before{content:"";width:.55em;height:.55em;border-radius:3px;background:var(--apricot)}
.chi .in-breve ul{list-style:none;margin:0;padding:0;display:grid;gap:.55rem}
.chi .in-breve li{border-left:4px solid var(--verdigris);padding:.15rem 0 .15rem .9rem;font-size:.9rem;line-height:1.4}
.chi .in-breve li:nth-child(2){border-color:var(--apricot)}
.chi .in-breve li:nth-child(3){border-color:var(--flax)}
.chi .in-breve li:nth-child(4){border-color:var(--jet)}
.scuro .chi .in-breve li:nth-child(4){border-color:var(--testo)}
.chi .in-breve strong{display:block;font-weight:600;font-size:1rem}

/* 3. Servizi: banda apricot e quattro card come quelle dei progetti */
.servizi .pagina-testa{padding-block:6.5rem 2.25rem;margin-bottom:2rem}
.servizi .pagina-sottotitolo{max-width:58rem}
.servizi .griglia{display:grid;grid-template-columns:repeat(4,1fr);gap:1.25rem}
.servizi .carta-progetto{height:auto}
.servizi .carta-progetto-img{aspect-ratio:16/10}
.servizi .carta-progetto-testo{padding:1.1rem 1.25rem 1.3rem}
.servizi .carta-progetto-brand{font-size:1.1rem;letter-spacing:.01em;line-height:1.25;margin-bottom:.35rem}
.servizi .carta-progetto-testo p{font-size:.86rem;line-height:1.55;margin:0}
/* Angoli delle card ritagliati con clip-path: con border-radius + overflow Anteprima del Mac disegnava una riga verticale
   a metà della quarta card (22/11, provato col motore del Mac via sips) */
.carta-progetto{border-radius:0;clip-path:inset(0 round 1.25rem)}
/* Card flax in scuro verso l'oliva: il marrone del sito (#443629) affiancato all'apricot (#4D3626) sembrava la stessa tinta (22/11) */
.scuro .carta-progetto.tema-flax{--fondo:#3B3922}

/* 5. Competenze e setup: banda verdigris, tre card del sito (riga colorata in cima) e due riquadri con foto */
.competenze .pagina-testa{padding-block:6.5rem 2rem;margin-bottom:2rem}
.competenze .gruppi{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem}
.competenze .attrezzi{margin-top:1.25rem}
.scheda-box ul{margin:0;padding-left:1.1rem}
.scheda-box li{margin-bottom:.35em;font-size:.95rem;line-height:1.5}
.scheda-box h3{font-size:1.15rem;margin:0 0 .7rem}
.box-1{border-top-color:var(--verdigris);background:rgba(123,181,178,.14)}
.box-2{border-top-color:var(--apricot);background:rgba(246,201,172,.16)}
.box-3{border-top-color:var(--flax);background:rgba(237,210,134,.16)}
.box-4{border-top-color:var(--testo);background:rgba(230,226,220,.06)}
html:not(.scuro) .box-4{background:rgba(45,45,42,.05)}
.scheda-box.con-foto{display:grid;grid-template-columns:16rem 1fr 1fr;gap:2.25rem;align-items:start}
.scheda-box.con-foto img{width:16rem;height:11rem;object-fit:cover;border-radius:.6rem}
.scheda-box.con-foto p{font-size:.95rem;line-height:1.55;margin:0}

/* 6. Progetti: otto card dei progetti del sito, come nel portfolio */
.progetti .testa-sezione{padding-top:5.6rem;margin-bottom:1.2rem}
.testa-sezione h1{font-size:2.6rem;font-weight:700;margin:0}
.testa-sezione .etichetta{margin-bottom:.6rem}
.progetti .griglia{display:grid;grid-template-columns:repeat(4,1fr);gap:1.1rem}
.progetti .carta-progetto-img{aspect-ratio:2/1}
.progetti .carta-progetto-testo{padding:.75rem 1rem .9rem;gap:.15rem}
.progetti .carta-progetto-brand{font-size:.98rem;letter-spacing:.01em;line-height:1.25}
.progetti .carta-progetto-frase{font-size:.78rem;line-height:1.45;font-style:normal;opacity:.85}
.progetti .carta-progetto-cat{font-size:.66rem;padding-top:.4rem}

/* 7. Clienti: solo nomi, per settore, in sei riquadri uguali (22/11: i loghi misti ai nomi non reggevano; i loghi sono già a pagina 2) */
.clienti-pag .testa-sezione{padding-top:6.5rem;margin-bottom:1.6rem}
.settori{display:grid;grid-template-columns:repeat(3,1fr);grid-auto-rows:1fr;gap:1.25rem}
.settore{padding:1.3rem 1.5rem 1.4rem}
.settore h3{font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;font-weight:600;opacity:.8;margin:0 0 1rem}
.settore .nomi{list-style:none;margin:0;padding:0;columns:2;column-gap:1.5rem}
.settore .nomi li{font-size:1.05rem;font-weight:500;line-height:1.3;margin:0 0 .55rem;break-inside:avoid}
.clienti-pag .altri{margin-top:1.1rem;font-size:.9rem;opacity:.75}

/* 8. Contatti: chiude come la copertina, banda sabbia col titolo, riga dei colori, recapiti sotto */
.contatti::before{content:"";position:absolute;left:0;right:0;top:0;height:46%;background:linear-gradient(180deg,#443629 0%,color-mix(in srgb,#443629 74%,#2F302C) 100%)}
html:not(.scuro) .contatti::before{background:linear-gradient(180deg,var(--flax) 0%,color-mix(in srgb,var(--flax) 74%,var(--snow)) 100%)}
.contatti .cover-strisce{top:46%}
.contatti-titolo{position:absolute;left:8rem;bottom:calc(54% + 2.75rem);margin:0;font-size:5rem;font-weight:700;line-height:1;color:var(--flax)}
html:not(.scuro) .contatti-titolo{color:var(--jet)}
.contatti .logo-grande{position:absolute;right:8rem;top:calc(23% - 6rem);width:12rem;height:auto}
.contatti-corpo{position:absolute;left:8rem;right:8rem;top:calc(46% + 4rem);display:grid;grid-template-columns:1fr 1fr auto;gap:4rem;align-items:start}
.contatti-corpo .nome{font-size:1.6rem;font-weight:700;letter-spacing:.03em;margin:0 0 .6rem}
.contatti-corpo .recapiti{font-size:1.3rem;line-height:1.7;margin:0}
.contatti-corpo a{text-decoration:none;border-bottom:2px solid var(--verdigris)}
.contatti-corpo .vetrina{font-size:1.05rem;margin:0 0 1.1rem;opacity:.9}
.contatti-corpo .social{font-size:1rem;margin:1.4rem 0 0}
.contatti-corpo .social a{border-bottom-color:var(--apricot)}
.qr-box{display:flex;flex-direction:column;align-items:center;gap:.8rem;font-size:.8rem;opacity:.95}
.qr{width:11rem;background:var(--snow);border-radius:.9rem;padding:.8rem}
.qr svg{width:100%;height:auto;display:block}
.qr svg path{fill:var(--jet)}
</style>
</head>
<body>
{#- Intestazione: il marchio del sito; in copertina solo il logo, il nome c'è già nel titolo -#}
{%- macro testata(attiva) %}
<header class="foglio-testa">
  <a class="marchio" href="{{ link }}/{{ q }}">
    <img class="marchio-logo" src="/assets/img/logo-sdrv-96.png" alt="Sound Design RV" width="52" height="52">
    {%- if attiva %}
    <span class="marchio-nome">RICCARDO VOJVODA</span>
    <span class="marchio-ruolo">{{ t.marchioRuolo }}</span>
    {%- endif %}
  </a>
</header>
{%- endmacro %}
{#- Versione del profilo (24/11/2026, Riccardo: "così si riconosce"): stampata in piccolo solo nell'ultima pagina.
    v1 = i PDF Canva di dicembre 2025, v2 = questo estratto del sito. Alzare il numero a ogni versione nuova pubblicata. -#}
{%- set versionePdf = ({ it: "Profilo", en: "Profile", fr: "Profil" }[p.lang] or "Profilo") + " v2 · 11/2026" %}
{%- macro piede(n, versione) %}<div class="foglio-piede"><a href="{{ link }}/{{ q }}">sounddesignrv.com</a><span>{% if versione %}{{ versione }} · {% endif %}{{ n }} / {{ totale }}</span></div>{% endmacro %}

{#- 1. Copertina: logo, nome e ruolo -#}
<section class="foglio cover" id="inizio">
  <div class="cover-logo-box"><img class="cover-logo" src="/assets/img/logo-sdrv.png" alt="Sound Design RV"></div>
  <div class="cover-testo">
    <h1 class="cover-nome"><span>RICCARDO</span> <span>VOJVODA</span></h1>
    <p class="cover-ruolo"><span class="r1">{{ p.copertina.ruoli[0] }}</span> | <span class="r2">{{ p.copertina.ruoli[1] }}</span></p>
  </div>
  <span class="cover-strisce" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
</section>

{#- 2. La home: showreel e loghi -#}
<section class="foglio copertina" id="copertina">
  {{ testata("") }}
  <div class="eroe">
    <div class="contenitore eroe-griglia">
      <div class="eroe-testo">
        <h1>RICCARDO VOJVODA</h1>
        <p class="eroe-ruolo">{{ p.copertina.ruoli | join(" | ") }}</p>
        <p class="eroe-intro">{{ p.copertina.frase }}</p>
        <div class="eroe-azioni">
          <a class="bottone" href="{{ link }}/{{ q }}&utm_content=showreel">{{ p.copertina.showreel }}</a>
          <a class="bottone bottone-secondario" href="{{ link }}/{{ q }}">sounddesignrv.com</a>
        </div>
      </div>
      <div class="eroe-reel">
        <a class="video" href="{{ link }}/{{ q }}&utm_content=showreel">
          <img class="video-poster" src="{% imgUrl sito.showreel.poster, 1600 %}" alt="Showreel 2026">
          <span class="video-play"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>{{ p.copertina.ascolta }}</span>
          <span class="video-durata">{{ sito.showreel.durata | tempo }}</span>
        </a>
      </div>
    </div>
  </div>
  <section class="clienti">
    <div class="contenitore">
      <div class="clienti-testa">
        <h2 class="etichetta">{{ p.copertina.brand }}</h2>
        <a class="link-freccia" href="#clienti">{{ p.copertina.vediTutti }}</a>
      </div>
      <ul class="loghi loghi-home">
        {%- for n in sito.loghiHome %}{% for l in sito.loghi %}{% if l[1] == n %}
        <li><img {% if l[2] %}class="logo-per-chiaro" {% endif %}src="/assets/img/loghi/{{ l[0] }}" alt="{{ l[1] }}">{% if l[2] %}<img class="logo-per-scuro" src="/assets/img/loghi/{{ l[2] }}" alt="{{ l[1] }}">{% endif %}</li>
        {%- endif %}{% endfor %}{% endfor %}
      </ul>
    </div>
  </section>
  {{ piede("02") }}
</section>

{#- 2. Chi sono -#}
<section class="foglio chi" id="chi-sono">
  {{ testata("chi-sono") }}
  <header class="pagina-testa tema-flax">
    <div class="contenitore pagina-testa-ritratto">
      <div>
        <p class="etichetta">{{ p.chiSono.occhiello }}</p>
        <h1>{{ p.chiSono.h1 }}</h1>
        <p class="pagina-sottotitolo">{{ p.chiSono.titolo }}</p>
      </div>
      <div class="ritratto-box"><div class="ritratto-ombra"><img class="ritratto" src="{% imgUrl 'riccardo-vojvoda-ritratto.jpg', 1200 %}" alt="Riccardo Vojvoda in studio"></div></div>
    </div>
  </header>
  <div class="contenitore corpo">
    <div>
      {%- for par in p.chiSono.paragrafi %}<p>{{ par }}</p>{% endfor %}
    </div>
    <div class="in-breve">
      <h2>{{ p.chiSono.inBreveTitolo }}</h2>
      <ul>{% for v in p.chiSono.inBreve %}<li><strong>{{ v[0] }}</strong>{{ v[1] }}</li>{% endfor %}</ul>
    </div>
  </div>
  {{ piede("03") }}
</section>

{#- 3. Servizi -#}
<section class="foglio servizi" id="servizi">
  {{ testata("servizi") }}
  <header class="pagina-testa tema-apricot">
    <div class="contenitore">
      <p class="etichetta">{{ p.servizi.occhiello }}</p>
      <h1>{{ p.servizi.h1 }}</h1>
      <p class="pagina-sottotitolo">{{ p.servizi.intro }}</p>
    </div>
  </header>
  <div class="contenitore griglia">
    {%- set temi = ["tema-verdigris", "tema-apricot", "tema-flax", "tema-snow"] %}
    {%- for v in p.servizi.voci %}
    <div class="carta-progetto {{ temi[loop.index0] }}">
      <span class="carta-progetto-img"><img src="{% imgUrl v[1], 800 %}" alt="" style="object-position:{{ v[3] or '50% 50%' }}"></span>
      <span class="carta-progetto-testo">
        <strong class="carta-progetto-brand">{{ v[0] }}</strong>
        <p>{{ v[2] }}</p>
      </span>
    </div>
    {%- endfor %}
  </div>
  {{ piede("04") }}
</section>
{#- 5. Competenze e setup -#}
<section class="foglio competenze" id="competenze">
  {{ testata("competenze") }}
  <header class="pagina-testa tema-verdigris">
    <div class="contenitore"><h1>{{ p.pagine[2] | join("") }}</h1></div>
  </header>
  <div class="contenitore">
    <div class="gruppi">
      {%- for g in p.competenze.gruppi %}
      <div class="scheda-box box-{{ loop.index }}"><h3>{{ g[0] }}</h3><ul>{% for v in g[1] %}<li>{{ v }}</li>{% endfor %}</ul></div>
      {%- endfor %}
    </div>
    <div class="attrezzi">
      <div class="scheda-box box-4 con-foto"><img src="{% imgUrl 'profilo/regia-offlmts-vista-ampia.jpg', 800 %}" alt="">
        <div><h3>{{ p.competenze.setupTitolo }}</h3><p>{{ p.competenze.setup }}</p></div>
        <div><h3>{{ p.competenze.kitTitolo }}</h3><p>{{ p.competenze.kit }}</p></div>
      </div>
    </div>
  </div>
  {{ piede("05") }}
</section>

{#- 6. Progetti selezionati -#}
<section class="foglio progetti" id="progetti">
  {{ testata("progetti") }}
  <div class="contenitore">
    <div class="testa-sezione"><p class="etichetta">{{ p.progetti.occhiello }}</p><h1>{{ p.pagine[3] | join("") }}</h1></div>
    <div class="griglia">
      {%- set temi = ["tema-verdigris", "tema-apricot", "tema-flax", "tema-jet"] %}
      {%- for v in p.progetti.voci %}
      <a class="carta-progetto {{ temi[loop.index0 % 4] }}" href="{{ link }}/progetti/{{ v.slug }}/{{ q }}">
        <span class="carta-progetto-img"><img src="{% imgUrl v.img, 800 %}" alt=""></span>
        <span class="carta-progetto-testo">
          <strong class="carta-progetto-brand">{{ v.titolo }}</strong>
          <span class="carta-progetto-frase">{{ v.testo }}</span>
          <small class="carta-progetto-cat">{{ v.categoria }}</small>
        </span>
      </a>
      {%- endfor %}
    </div>
  </div>
  {{ piede("06") }}
</section>

{#- 7. Clienti -#}
<section class="foglio clienti-pag" id="clienti">
  {{ testata("clienti") }}
  <div class="contenitore">
    <div class="testa-sezione"><p class="etichetta">{{ p.copertina.brand }}</p><h1>{{ p.pagine[5] | join("") }}</h1></div>
    <div class="settori">
      {%- for st in p.clienti.settori %}
      <div class="scheda-box settore box-{{ (loop.index0 % 4) + 1 }}">
        <h3>{{ st.nome }}</h3>
        <ul class="nomi">{% for n in st.nomi %}<li>{{ n }}</li>{% endfor %}</ul>
      </div>
      {%- endfor %}
    </div>
    <p class="altri">{{ p.clienti.altri }}</p>
  </div>
  {{ piede("07") }}
</section>

{#- 8. Contatti -#}
<section class="foglio contatti" id="contatti">
  
  <h1 class="contatti-titolo">{{ p.contatti.titolo }}</h1>
  <img class="logo-grande" src="/assets/img/logo-sdrv.png" alt="">
  <span class="cover-strisce" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  <div class="contatti-corpo">
    <div>
      <p class="nome">RICCARDO VOJVODA</p>
      <p class="recapiti"><a href="mailto:{{ sito.email }}">{{ sito.email }}</a><br>
      <a href="tel:{{ sito.telefonoHref }}">{{ sito.telefono }}</a><br>
      <a href="{{ link }}/{{ q }}">sounddesignrv.com</a></p>
    </div>
    <div>

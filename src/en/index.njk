    <h2 id="dietro-titolo">BEHIND THE SOUND DESIGN</h2>
    <p>A look behind the scenes: sessions, stems and before/after comparisons, headphones on. On Instagram, <a href="{{ sito.social.instagram }}" rel="me noopener">@sound_design_rv</a>.</p>
  </div>
  <ul class="dietro-strip" aria-label="Behind the sound design reel covers">
    {%- asyncEach p in instagram %}
    <li><a href="{{ p.url }}" target="_blank" rel="noopener">{% img "instagram/" + p.copertina, ("Instagram reel: " if p.tipo == "reel" else "Instagram post: ") + p.didascalia, "(min-width: 60em) 12vw, 40vw" %}</a></li>
    {%- endeach %}
  </ul>
</section>

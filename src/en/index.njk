<section class="eroe">
  <div class="contenitore eroe-griglia">
    <div class="eroe-testo">
      <h1>RICCARDO VOJVODA</h1>
      <p class="eroe-ruolo">Sound Designer | Audio Post-Producer</p>
      <p class="eroe-intro eroe-intro-lunga">Production sound and audio post-production for video productions, communication agencies, filmmakers, directors and artists. Film, documentary, branded content, corporate and institutional video, animation and motion graphics, video games, radio spots: layered sound design, stereo and surround mixing, music selection and composition, synthetic voice direction, ADR and location sound with a full kit.</p>
      <p class="eroe-intro eroe-intro-corta">Production sound and audio post for film, documentary, branded content, animation and video games: sound design, stereo and surround mixing, music, voices, ADR and location sound.</p>
      <p class="eroe-nota">Remote work in Italian, English and French.<br class="a-capo-desktop"> For shoots, on location in Italy and abroad.</p>
      <div class="eroe-azioni">
        <a class="bottone" href="/en/portfolio/">See the projects</a>
        <a class="bottone bottone-secondario" href="/en/contact/">Get in touch</a>
      </div>
    </div>
    <div class="eroe-reel">
      {% set v = { youtube: sito.showreel.youtube, titolo: "Showreel 2026 - Sound Design RV", durata: sito.showreel.durata } %}
      {% set poster = sito.showreel.poster %}
      {% set eager = true %}
      {% include "parti/video.njk" %}
      <nav class="capitoli" aria-label="Showreel chapters" data-video-capitoli>
        <p class="capitoli-titolo"><span>In the reel</span> <small>Pick a chapter or start from the top</small></p>
        <ol class="capitoli-lista">
          {%- for c in sito.showreel.capitoli %}
          <li><button type="button" data-capitolo="{{ c.t }}" aria-label="{{ c.titolo }}, from {{ c.t | tempo }}"><span class="capitoli-nome">{{ c.titolo }}</span><span class="capitoli-tempo">{{ c.t | tempo }}</span></button></li>
          {%- endfor %}
        </ol>
      </nav>
    </div>
  </div>
</section>

<section class="clienti" aria-labelledby="clienti-titolo">
  <div class="contenitore">
    <h2 id="clienti-titolo" class="etichetta">Brands and productions</h2>
    <ul class="loghi">
      {%- for l in sito.loghi %}
      <li><img {% if l[2] %}class="logo-per-chiaro" {% endif %}src="/assets/img/loghi/{{ l[0] }}" alt="{{ l[1] }}" loading="lazy" decoding="async" width="150" height="75">{% if l[2] %}<img class="logo-per-scuro" src="/assets/img/loghi/{{ l[2] }}" alt="{{ l[1] }}" loading="lazy" decoding="async" width="150" height="75">{% endif %}</li>
      {%- endfor %}
    </ul>
  </div>
</section>

{%- set l = "en" %}
{% include "parti/home-anteprime.njk" %}

<section class="dietro tema-jet" aria-labelledby="dietro-titolo">

<footer class="pie">
  <div class="contenitore pie-griglia">
    <div class="pie-blocco">
      <strong>{{ sito.nome }}</strong>
      <span>{{ sito.titolare }} · {{ t.pie.piva }} {{ sito.piva }}</span>
      <span><a href="mailto:{{ sito.email }}">{{ sito.email }}</a> · <a href="tel:{{ sito.telefonoHref }}">{{ sito.telefono }}</a></span>
      <span class="pie-lingue">{% include "parti/lingue.njk" %}</span>
    </div>
    <nav class="pie-blocco" aria-label="{{ t.menu.pagine }}">
      <a href="{{ t.url.portfolio }}">{{ t.menu.portfolio }}</a>
      <a href="{{ t.url.servizi }}">{{ t.menu.servizi }}</a>
      <a href="{{ t.url.chiSono }}">{{ t.menu.chiSono }}</a>
      <a href="{{ t.url.faq }}">{{ t.menu.faq }}</a>
      {%- if t.url.approfondimenti %}<a href="{{ t.url.approfondimenti }}">{{ t.menu.approfondimenti }}</a>{% endif %}
      <a href="{{ t.url.contatti }}">{{ t.menu.contatti }}</a>
    </nav>
    <nav class="pie-blocco" aria-label="{{ t.menu.profili }}">
      <a href="{{ sito.social.instagram }}" rel="me noopener">Instagram</a>
      <a href="{{ sito.social.linkedin }}" rel="me noopener">LinkedIn</a>
      <a href="{{ sito.social.imdb }}" rel="me noopener">IMDb</a>
      <a href="{{ sito.social.cromo }}" rel="noopener">CROMO (video)</a>
    </nav>
  </div>
  <p class="pie-copy contenitore">© {{ "" | anno }} {{ sito.nome }} - {{ sito.titolare }}</p>
</footer>

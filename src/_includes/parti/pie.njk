<footer class="pie">
  <div class="contenitore pie-griglia">
    <div class="pie-blocco">
      <strong>{{ sito.nome }}</strong>
      <span>{{ sito.titolare }} · P.IVA {{ sito.piva }}</span>
      <span><a href="mailto:{{ sito.email }}">{{ sito.email }}</a> · <a href="tel:{{ sito.telefonoHref }}">{{ sito.telefono }}</a></span>
    </div>
    <nav class="pie-blocco" aria-label="Pagine">
      <a href="/#progetti">Portfolio</a>
      <a href="/servizi/">Servizi</a>
      <a href="/chi-sono/">Chi sono</a>
      <a href="/faq/">FAQ</a>
      <a href="/contatti/">Contatti</a>
    </nav>
    <nav class="pie-blocco" aria-label="Profili esterni">
      <a href="{{ sito.social.instagram }}" rel="me noopener">Instagram</a>
      <a href="{{ sito.social.linkedin }}" rel="me noopener">LinkedIn</a>
      <a href="{{ sito.social.imdb }}" rel="me noopener">IMDb</a>
      <a href="{{ sito.social.cromo }}" rel="noopener">CROMO (video)</a>
    </nav>
  </div>
  <p class="pie-copy contenitore">© {{ "" | anno }} {{ sito.nome }} - {{ sito.titolare }}</p>
</footer>

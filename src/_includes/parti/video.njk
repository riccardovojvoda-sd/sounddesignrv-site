{#- Video con copertina locale: l'iframe YouTube (dominio nocookie) si carica solo al clic.
    Parametri: v = { youtube | file, titolo, immagine }, poster = percorso immagine sotto assets/img, eager = bool -#}
{%- if v.immagine %}{% set posterPath = "progetti/" + v.immagine %}{% else %}{% set posterPath = poster %}{% endif -%}
{%- set caricamento = "eager" if eager else "lazy" -%}
{%- set tv = testi[lang or "it"].video -%}
{%- if v.youtube -%}
<div class="video" data-yt="{{ v.youtube }}" data-titolo="{{ v.titolo }}">
  {% img posterPath, tv.anteprima + ": " + v.titolo, "(min-width: 60em) 55vw, 100vw", caricamento, "video-poster" %}
  <button class="video-play" type="button" aria-label="{{ tv.ascolta }}: {{ v.titolo }}">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
    <span>{{ tv.ascolta }}</span>
  </button>
  {%- if v.durata %}<span class="video-durata" aria-label="{{ tv.durata }} {{ v.durata | tempo }}">{{ v.durata | tempo }}</span>{% endif %}
  <noscript><a href="https://www.youtube.com/watch?v={{ v.youtube }}">{{ tv.suYoutube }}: {{ v.titolo }}</a></noscript>
</div>
{%- elif v.file -%}
<div class="video video-locale">
  <video controls preload="none" playsinline poster="{% imgUrl posterPath, 1200 %}" title="{{ v.titolo }}">
    <source src="/assets/video/{{ v.file }}" type="video/mp4">
  </video>
  {%- if v.durata %}<span class="video-durata video-durata-locale">{{ v.durata | tempo }}</span>{% endif %}
</div>
{%- endif -%}

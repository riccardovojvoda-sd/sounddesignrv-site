<header class="testata">
  <a class="marchio" href="{{ t.url.home }}" aria-label="{{ sito.nome }}, home">
    <img class="marchio-logo" src="/assets/img/logo-sdrv-96.png" alt="" width="52" height="52" decoding="async">
    <span class="marchio-nome">RICCARDO VOJVODA</span>
    <span class="marchio-ruolo">{{ t.marchioRuolo }}</span>
  </a>
  <nav class="menu" aria-label="{{ t.menu.principale }}">
    <a href="{{ t.url.portfolio }}"{% if page.url == t.url.home %} aria-current="page"{% endif %}>{{ t.menu.portfolio }}</a>
    <a href="{{ t.url.servizi }}"{% if page.url == t.url.servizi %} aria-current="page"{% endif %}>{{ t.menu.servizi }}</a>
    <a href="{{ t.url.chiSono }}"{% if page.url == t.url.chiSono %} aria-current="page"{% endif %}>{{ t.menu.chiSono }}</a>
    <a class="menu-cta" href="{{ t.url.contatti }}"{% if page.url == t.url.contatti %} aria-current="page"{% endif %}>{{ t.menu.contatti }}</a>
  </nav>
  {% set lingueTendina = true %}{% include "parti/lingue.njk" %}{% set lingueTendina = false %}
</header>

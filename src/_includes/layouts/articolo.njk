---
layout: layouts/base.njk
---
{#- Articolo degli Approfondimenti / Insights: copertina, titolo, data, testo, altri articoli.
    Le versioni nelle altre lingue si trovano con `chiave` (stessa chiave in IT, EN e FR). -#}
{%- set t = testi[lang or "it"] %}
{%- set lista = collections["approfondimenti" + ("_" + lang if lang and lang != "it" else "")] %}
{%- set minuti = content | minutiLettura %}
{%- set altre = [] %}
{%- for a in alternative %}{% if a.lang != (lang or "it") %}{% set altre = (altre.push(a), altre) %}{% endif %}{% endfor %}
{%- if bozza %}{% for p in collections.all %}{% if p.data.chiave == chiave and p.url != page.url and p.url %}{% set altre = (altre.push({ url: p.url, lang: p.data.lang or "it" }), altre) %}{% endif %}{% endfor %}{% endif %}
<article class="pagina articolo tema-snow">
  {%- if bozza %}<p class="articolo-bozza contenitore">{{ t.articolo.bozza }}</p>{% endif %}
  <header class="pagina-testa">
    <div class="contenitore articolo-testa">
      <p class="briciole"><a href="{{ t.url.approfondimenti }}">{{ t.menu.approfondimenti }}</a>{% if categoria %} / {{ categoria }}{% endif %}</p>
      <h1>{{ titolo }}</h1>
      {%- if sottotitolo %}<p class="pagina-sottotitolo">{{ sottotitolo }}</p>{% endif %}
      <p class="articolo-meta">
        <time datetime="{{ page.date | dataIso }}">{{ t.articolo.pubblicato }} {{ page.date | dataLunga(lang) }}</time>
        {%- if aggiornato %} · {{ t.articolo.aggiornato }} <time datetime="{{ aggiornato | dataIso }}">{{ aggiornato | dataLunga(lang) }}</time>{% endif %}
        · {{ minuti }} {{ t.articolo.minuti }}
        {%- for a in altre %} · <a href="{{ a.url }}" hreflang="{{ a.lang }}" lang="{{ a.lang }}">{{ testi[a.lang].articolo.leggiIn }}</a>{% endfor %}
      </p>
    </div>
  </header>
  {%- if copertina %}
  <figure class="articolo-copertina contenitore">
    {% img "approfondimenti/" + copertina, copertinaAlt or titolo, "(min-width: 80rem) 76rem, 100vw", "eager" %}
    {%- if copertinaCredito %}<figcaption>{{ copertinaCredito | mdInline | safe }}</figcaption>{% endif %}
  </figure>
  {%- endif %}
  <div class="contenitore pagina-corpo prosa articolo-corpo">
    {{ content | safe }}
  </div>
  {%- set altri = [] %}
  {%- for p in lista %}{% if p.url != page.url and altri.length < 3 %}{% set altri = (altri.push(p), altri) %}{% endif %}{% endfor %}
  {%- if altri.length %}
  <aside class="contenitore articolo-altri" aria-label="{{ t.articolo.altri }}">
    <h2 class="etichetta">{{ t.articolo.altri }}</h2>
    <ul class="elenco-approfondimenti">
      {%- set senza_data = true %}
      {%- for a in altri %}
      {% include "parti/voce-articolo.njk" %}
      {%- endfor %}
    </ul>
    <p><a class="bottone bottone-secondario" href="{{ t.url.approfondimenti }}">{{ t.articolo.tutti }}</a></p>
  </aside>
  {%- endif %}
</article>
{%- if not bozza %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": titolo,
  "description": descrizione_seo or descrizione,
  "inLanguage": lang or "it",
  "datePublished": page.date | dataIso,
  "dateModified": (aggiornato or page.date) | dataIso,
  "image": (sito.url + (("approfondimenti/" + copertina) | imgUrlSync(1200))) if copertina else undefined,
  "author": { "@type": "Person", "name": sito.titolare, "url": sito.url + t.url.chiSono },
  "publisher": { "@id": sito.url + "/#riccardo-vojvoda" },
  "mainEntityOfPage": sito.url + page.url
} | json | safe }}</script>
{%- endif %}

<!doctype html>
{%- set t = testi[lang or "it"] %}
{%- set alternative = collections.all | traduzioni(chiave) %}
<html lang="{{ lang or "it" }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src https://www.youtube-nocookie.com; connect-src 'self'; base-uri 'self'; form-action 'self' mailto:; upgrade-insecure-requests">
{%- if chiave == "home" and (lang or "it") == "it" %}
{#- Ancore del vecchio sito (/#maserati, /#missinghead...): girano ancora nelle mail gia' inviate e nel CRM.
    Qui non esistono piu': chi arriva con una di quelle va alla pagina del progetto. Deve stare PRIMA del
    reindirizzo per lingua, che altrimenti butta via l'ancora. #}
<script>(function(){try{var m={maserati:"maserati-mc20",alfaromeo:"alfa-romeo-quadrifoglio",arcadia:"arcadia-earth",missinghead:"the-missing-head",diadora:"diadora-run-valley",adria:"adria-were-ready",ponte:"ponte-1948-fast-food-series",pitars:"pitars",alpi:"alpi-wood",weldan:"weldan",lainox:"lainox-naboo",fitt:"fitt-industrial"};var h=location.hash.replace("#","").toLowerCase();if(m[h]){window.ancoraVecchia=true;location.replace("/progetti/"+m[h]+"/");}}catch(e){}})();</script>
{#- Lingua: solo la home italiana, solo se il browser preferisce inglese o francese e non si arriva da una pagina del sito
    (cosi' il selettore lingua funziona sempre). Sostituisce il redirect lato server: GitHub Pages non ne ha. #}
<script>(function(){try{if(window.ancoraVecchia)return;if(document.referrer.indexOf(location.protocol+"//"+location.host+"/")===0)return;var l=((navigator.languages&&navigator.languages[0])||navigator.language||"").toLowerCase();if(l.indexOf("en")===0)location.replace("/en/");else if(l.indexOf("fr")===0)location.replace("/fr/");}catch(e){}})();</script>
{%- endif %}
{%- set titoloPagina = titolo_seo or titolo or sito.titolare %}
{%- set descPagina = descrizione_seo or descrizione or sito.descrizione %}
{%- set urlPagina = sito.url + page.url %}
<title>{{ titoloPagina }}</title>
<meta name="description" content="{{ descPagina }}">
{%- if noindex %}<meta name="robots" content="noindex">{% endif %}
<link rel="canonical" href="{{ urlPagina }}">
{%- for a in alternative %}
<link rel="alternate" hreflang="{{ a.lang }}" href="{{ sito.url }}{{ a.url }}">
{%- endfor %}
{%- if alternative.length > 1 %}
<link rel="alternate" hreflang="x-default" href="{{ sito.url }}{{ alternative[0].url }}">
{%- endif %}
<meta property="og:type" content="{{ og_type or 'website' }}">
<meta property="og:site_name" content="{{ sito.nome }}">
<meta property="og:title" content="{{ titoloPagina }}">
<meta property="og:description" content="{{ descPagina }}">
<meta property="og:url" content="{{ urlPagina }}">
<meta property="og:locale" content="{{ t.locale }}">
{%- set ogImg = immagine_og or "showreel-2026-cover.png" %}
<meta property="og:image" content="{{ sito.url }}{% imgUrl ogImg, 1200 %}">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#FFFBFA">
<link rel="icon" href="/favicon.png" type="image/png" sizes="64x64"><link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="/apple-touch-icon.png"><link rel="manifest" href="/site.webmanifest">
<link rel="preload" href="/assets/font/poppins-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/font/poppins-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<style>{% include "css/sito.css" %}</style>
{% block head %}{% endblock %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": sito.url + "/#riccardo-vojvoda",
  "name": sito.nome,
  "alternateName": "Riccardo Vojvoda Sound Designer",
  "url": sito.url,
  "image": sito.url + "/assets/img/logo-sdrv.png",
  "email": sito.email,
  "telephone": sito.telefonoHref,
  "vatID": "IT" + sito.piva,
  "founder": { "@type": "Person", "name": sito.titolare, "jobTitle": "Sound Designer, Audio Post-Producer", "sameAs": [sito.social.instagram, sito.social.linkedin, sito.social.imdb] },
  "areaServed": ["Italia", "Francia", "Europa"],
  "availableLanguage": ["it", "en", "fr"],
  "knowsAbout": ["sound design", "post-produzione audio", "dialogue editing", "mix 5.1", "mix 7.1", "fonica di presa diretta", "sound design per planetari", "installazioni immersive", "ADR", "foley"],
  "sameAs": [sito.social.instagram, sito.social.linkedin, sito.social.imdb]
} | json | safe }}</script>
</head>
<body class="{{ classeBody or '' }}">
<a class="salta" href="#contenuto">{{ t.salta }}</a>
{% include "parti/testata.njk" %}
<main id="contenuto">
{{ content | safe }}
</main>
{% include "parti/contatto.njk" %}
{% include "parti/pie.njk" %}
<a class="in-alto" href="#" aria-label="{{ t.tornaSu }}" title="{{ t.tornaSu }}" hidden><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M6 14l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
<script src="/assets/js/video.js" defer></script>
<script src="/assets/js/in-alto.js" defer></script>
</body>
</html>

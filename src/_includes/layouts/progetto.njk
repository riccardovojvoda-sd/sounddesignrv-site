---
layout: layouts/base.njk
og_type: article
---
{%- set descrizioneBreve = content | testoPiano %}
{%- set multi = video.length > 1 %}
<article class="scheda {{ tema | slugTema }}">
  <header class="scheda-testa">
    <div class="contenitore">
      <p class="briciole"><a href="/#progetti">Portfolio</a> / {{ categoria }}</p>
      <h1 class="scheda-brand">{{ brand }}</h1>
      <p class="scheda-titolo">{{ titolo }}</p>
      <p class="scheda-frase">{{ frase }}</p>
    </div>
  </header>
  <div class="contenitore scheda-corpo{% if multi %} scheda-corpo-serie{% endif %}">
    {%- if not multi %}
    <div class="scheda-media">
      {%- set poster = "progetti/" + immagine %}
      {%- set eager = true %}
      {%- asyncEach v in [video[0]] %}
      {% include "parti/video.njk" %}
      {%- endeach %}
    </div>
    {%- endif %}
    <div class="scheda-testo">
      <p class="scheda-crediti">{{ crediti }}</p>
      <div class="scheda-descrizione">{{ content | safe }}</div>
      <dl class="scheda-meta">
        <div><dt>Categoria</dt><dd>{{ categoria }}</dd></div>
        <div><dt>Ruolo</dt><dd>{{ ruolo }}</dd></div>
      </dl>
    </div>
  </div>
  {%- if multi %}
  <section class="episodi contenitore" aria-labelledby="episodi-titolo">
    <h2 id="episodi-titolo" class="etichetta">Gli episodi</h2>
    <div class="episodi-lista">
      {%- asyncEach ep in video %}
      <article class="episodio">
        {%- set v = ep %}
        {%- set eager = loop.first %}
        {% include "parti/video.njk" %}
        <h3>{{ ep.titolo }}</h3>
        {%- if ep.descrizione %}<p>{{ ep.descrizione }}</p>{% endif %}
        {%- if ep.ruolo %}<p class="scheda-ruolo-ep">{{ ep.ruolo }}</p>{% endif %}
      </article>
      {%- endeach %}
    </div>
  </section>
  {%- endif %}
  {%- set lista = collections.progetti %}
  {%- for p in lista %}{% if p.url == page.url %}{% set idx = loop.index0 %}
    {%- set prec = lista[idx - 1] if idx > 0 else lista[lista.length - 1] %}
    {%- set succ = lista[idx + 1] if idx < lista.length - 1 else lista[0] %}
  <nav class="scheda-nav contenitore" aria-label="Altri progetti">
    <a rel="prev" href="{{ prec.url }}"><small>Precedente</small> {{ prec.data.brand }}</a>
    <a class="scheda-nav-tutti" href="/#progetti">Tutti i progetti</a>
    <a rel="next" href="{{ succ.url }}"><small>Successivo</small> {{ succ.data.brand }}</a>
  </nav>
  {%- endif %}{% endfor %}
</article>
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": brand + " - " + titolo,
  "description": descrizioneBreve,
  "thumbnailUrl": sito.url + "/assets/img/progetti/" + immagine,
  "uploadDate": page.date | dataIso,
  "embedUrl": ("https://www.youtube-nocookie.com/embed/" + video[0].youtube) if video[0].youtube else (sito.url + "/assets/video/" + video[0].file),
  "contentUrl": ("https://www.youtube.com/watch?v=" + video[0].youtube) if video[0].youtube else (sito.url + "/assets/video/" + video[0].file),
  "genre": categoria,
  "inLanguage": "it",
  "contributor": { "@type": "Person", "name": sito.titolare, "jobTitle": "Sound Designer", "url": sito.url },
  "about": ruolo
} | json | safe }}</script>

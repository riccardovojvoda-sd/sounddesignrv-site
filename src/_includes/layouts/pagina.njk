---
layout: layouts/base.njk
---
<article class="pagina {{ tema | slugTema }}">
  <header class="pagina-testa{% if testaTema %} {{ testaTema | slugTema }}{% endif %}">
    <div class="contenitore{% if ritratto %} pagina-testa-ritratto{% endif %}">
      <div>
        {%- if occhiello %}<p class="etichetta">{{ occhiello }}</p>{% endif %}
        <h1>{{ titolo }}</h1>
        {%- if sottotitolo %}<p class="pagina-sottotitolo">{{ sottotitolo }}</p>{% endif %}
      </div>
      {%- if ritratto %}{% img ritratto, ritrattoAlt or titolo, "(min-width: 48em) 18rem, 60vw", "eager", "ritratto" %}{% endif %}
    </div>
  </header>
  <div class="contenitore pagina-corpo prosa">
    {{ content | safe }}
  </div>
</article>

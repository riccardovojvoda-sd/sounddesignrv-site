---
layout: layouts/base.njk
---
<article class="pagina {{ tema | slugTema }}">
  <header class="pagina-testa">
    <div class="contenitore">
      {%- if occhiello %}<p class="etichetta">{{ occhiello }}</p>{% endif %}
      <h1>{{ titolo }}</h1>
      {%- if sottotitolo %}<p class="pagina-sottotitolo">{{ sottotitolo }}</p>{% endif %}
    </div>
  </header>
  <div class="contenitore pagina-corpo prosa">
    {{ content | safe }}
  </div>
</article>
